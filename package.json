{
  "name": "sarvam-bridge",
  "version": "1.0.0",
  "description": "Drop-in compatibility gateway that lets existing ElevenLabs, OpenAI Audio and Deepgram applications run on Sarvam AI with zero application code changes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.3",
    "dotenv": "16.4.7",
    "fastify": "5.11.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
