# ─── Required ────────────────────────────────────────────────────────────────
# Your Sarvam API key, from https://dashboard.sarvam.ai/
# This is the ONLY place it lives. Client apps never see it.
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Upstream ────────────────────────────────────────────────────────────────
SARVAM_BASE_URL=https://api.sarvam.ai
DEFAULT_TTS_MODEL=bulbul:v3
DEFAULT_STT_MODEL=saaras:v3
DEFAULT_LANGUAGE=en-IN
# Leave blank to let the bridge pick the best speaker per language.
DEFAULT_SPEAKER=

# ─── Gateway auth (optional but recommended in production) ───────────────────
# When set, callers must present this value as xi-api-key or Authorization.
# Lets you rotate client credentials without touching the Sarvam key.
GATEWAY_AUTH_TOKEN=

# ─── Cache (the main cost lever) ─────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=268435456
CACHE_TTL_SECONDS=3600

# ─── Resilience ──────────────────────────────────────────────────────────────
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_MAX_RETRIES=3
UPSTREAM_CONCURRENCY=8

# ─── Inbound rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=10

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=33554432

# Trust X-Forwarded-* headers. OFF by default on purpose: req.ip is a
# rate-limit bucketing key, so trusting forwarded headers from anyone lets a
# caller forge a new identity per request and bypass the limiter.
# Set to a comma-separated list of your proxy IPs/CIDRs (preferred), or "true".
# TRUST_PROXY=127.0.0.1,10.0.0.0/8
TRUST_PROXY=

# Fail loudly on parameters that have no Sarvam equivalent, instead of
# warning via header. Useful in CI to catch incomplete migrations.
STRICT_COMPAT=false

# Optional explicit voice mapping, JSON: {"<vendor_voice_id>":"<sarvam_speaker>"}
# VOICE_MAP={"21m00Tcm4TlvDq8ikWAM":"priya","pNInz6obpgDQGcFmaJgB":"shubh"}
